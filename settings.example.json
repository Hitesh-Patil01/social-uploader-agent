{
  "timezone": "Asia/Kolkata",
  "cover_frame_seconds": 7,
  "append_cta_if_missing": true,

  "fixed_text": {
    "cta": "❤️ Please share and follow! 🔔"
  },

  "youtube": {
    "channel_handle": "@your_youtube_handle",
    "mention": "@your_youtube_handle",
    "privacy": "private",
    "schedule_to_public": true,
    "publish_time": "08:00",
    "playlist_title": "Shorts",
    "ai_label": false,
    "hashtags": ["#shorts", "#yourhashtag1", "#yourhashtag2"],
    "tags": ["your tag one", "your tag two", "your tag three"]
  },

  "facebook": {
    "page_name": "Your Facebook Page Name",
    "mention": "Your Facebook Page Name",
    "publish_time": "08:00",
    "hashtags": ["#yourhashtag1", "#yourhashtag2"],
    "page_id": "",
    "page_token_env": "META_PAGE_TOKEN_1"
  },

  "instagram_accounts": [
    {
      "name": "your_instagram_handle",
      "mention": "@your_instagram_handle",
      "publish_time": "08:00",
      "hashtags": ["#yourhashtag1", "#yourhashtag2"],
      "ig_user_id": "",
      "page_token_env": "META_PAGE_TOKEN_1"
    },
    {
      "name": "your_second_instagram_handle",
      "mention": "@your_second_instagram_handle",
      "publish_time": "08:20",
      "hashtags": ["#yourhashtag1", "#yourhashtag2"],
      "ig_user_id": "",
      "page_token_env": "META_PAGE_TOKEN_2"
    }
  ]
}
