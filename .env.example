# Copy this file to ".env" and fill it in (see README, Part 4 onwards).
# Never share the filled-in .env and never put it on GitHub or in a cloud-synced folder.
# Write values right after the "=" with no spaces and no quotes.

# --- Telegram (required) ---
# Token from @BotFather. Chat id: run  python agent.py --chatid
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Which platforms are switched on ---
# Use the full words, separated by commas: youtube, facebook, instagram
# Tip: start with just "youtube" and add the others one at a time.
PLATFORMS=youtube

# --- Instagram: test one account at a time (optional) ---
# Names from settings.json, separated by commas. Leave empty to use all Instagram accounts.
IG_ACCOUNTS=

# --- Facebook / Instagram page tokens ---
# Do not type these by hand. Run  python meta_setup.py  and it fills them in.
# (The names must match "page_token_env" in settings.json.)
META_PAGE_TOKEN_1=
META_PAGE_TOKEN_2=
GRAPH_VERSION=v23.0

# --- Optional ---
# Folder to watch for new videos (for example a Google Drive / OneDrive folder). Default: the "inbox" folder here.
# Windows example: INBOX_DIR=C:\Users\YourName\Google Drive\social-inbox
INBOX_DIR=
# 1 = keep posted videos in the "done" folder, 0 = delete them after posting
KEEP_VIDEOS=1
# Local port used for the temporary Instagram video link. Change only if something else uses it.
TUNNEL_PORT=8765
# YouTube category number for uploads (22 = People & Blogs). Change only if you need another category.
YT_CATEGORY_ID=22
